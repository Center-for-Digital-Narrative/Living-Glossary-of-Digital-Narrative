---
import '../global.css';
import { ClientRouter } from 'astro:transitions';
import NavMain from "../components/NavMain.astro";
import Footer from "../components/Footer.astro";
import NavMobile from "../components/NavMobile.astro";
import NavSmall from "../components/NavSmall.astro";

interface Props {
    pageTitle: string;
    letter?: string;
}
const { pageTitle, letter } = Astro.props;
---
<html lang="en" style="overflow-y: scroll">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <slot name="head" />
    <ClientRouter />
</head>
<body class="flex flex-col min-h-screen dark:bg-black">

    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:p-2">Skip to main content</a>
    <NavMain />

    <NavSmall letter={letter} />
    <NavMobile />

    <main id="main" tabindex="-1" class="grow">
        <slot />
    </main>

    <div id="sr-status" class="sr-only" role="status" aria-live="polite"></div>

    <Footer />

</body>
</html>