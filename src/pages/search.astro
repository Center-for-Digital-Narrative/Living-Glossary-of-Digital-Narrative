---
import BaseLayout from '../layouts/BaseLayout.astro';
import {default as PageFind} from "astro-pagefind/components/Search"; // https://github.com/withastro/language-tools/issues/580
---
<style is:global>
.pagefind-ui {
    --pagefind-ui-scale: 1;
    --pagefind-ui-font: "Segoe UI", ui-sans-serif, system-ui, sans-serif;
    --pagefind-ui-text: #002934;
}
.dark .pagefind-ui {
    --pagefind-ui-primary: #d1d5db;
    --pagefind-ui-text: #d1d5db;
    --pagefind-ui-background: #152028;
    --pagefind-ui-border: #152028;
    --pagefind-ui-tag: #152028;
}

/* While Pagefind searches, its "Searching for ..." line becomes the five
   CDN dots (as in cdn.uib.no's DotsDivider), rising in turn. The words
   stay for screen readers. */
.pagefind-ui__message.is-searching {
    display: flex;
    justify-content: center;
    padding: 40px 0;
}
.pagefind-ui__message.is-searching .search-dots-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}
.search-dots {
    display: flex;
    gap: 15px;
}
.search-dots span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    animation: search-dot 1.2s ease-in-out infinite;
}
.search-dots span:nth-child(1) { background: #0076ad; }
.search-dots span:nth-child(2) { background: #95be63; animation-delay: 0.12s; }
.search-dots span:nth-child(3) { background: #5c83c1; animation-delay: 0.24s; }
.search-dots span:nth-child(4) { background: #1f7a73; animation-delay: 0.36s; }
.search-dots span:nth-child(5) { background: #4e9db4; animation-delay: 0.48s; }
@keyframes search-dot {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.55; }
    30% { transform: translateY(-10px); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
    .search-dots span {
        animation: none;
        opacity: 1;
    }
}
</style>
<BaseLayout pageTitle='Search | LGDN'>
    <div id="pagefind_container" class="container mt-4 px-2 relative" transition:name='search'>
        <h1 class="text-black dark:text-gray-200 text-4xl font-bold mb-4">Search</h1>
        <label id="search-label" for="search-input" class="sr-only">Search</label>
        <PageFind id="search" className="pagefind-ui" uiOptions={{ autofocus: true, showImages: false }} />
    </div>
</BaseLayout>
<script>
    document.addEventListener("astro:page-load", () => {
        const search = document.getElementById("search");
        const status = document.getElementById("sr-status");
        if (search && status) {
            let debounceTimer: number | undefined;

            const announce = (msg: string) => {
                status.textContent = "";
                setTimeout(() => (status.textContent = msg), 50);
            };

            const mirrorPagefindMessage = () => {
                const message = search.querySelector<HTMLElement>(".pagefind-ui__message");
                const text = message?.textContent?.trim();
                if (text) announce(text);
            };

            // Pagefind shows its "Searching for ..." line on its own while a
            // search runs, then replaces it with the results message.
            const showDots = () => {
                const message = search.querySelector<HTMLElement>(".pagefind-ui__message");
                if (!message || message.classList.contains("is-searching")) return;
                const results = message.nextElementSibling?.classList.contains("pagefind-ui__results");
                if (results || !message.textContent?.trim().startsWith("Searching")) return;
                const text = document.createElement("span");
                text.className = "search-dots-text";
                text.append(...message.childNodes);
                const dots = document.createElement("span");
                dots.className = "search-dots";
                dots.setAttribute("aria-hidden", "true");
                dots.innerHTML = "<span></span><span></span><span></span><span></span><span></span>";
                message.append(text, dots);
                message.classList.add("is-searching");
            };

            const observer = new MutationObserver(() => {
                showDots();
                window.clearTimeout(debounceTimer);
                debounceTimer = window.setTimeout(mirrorPagefindMessage, 150);
            });
            observer.observe(search, { childList: true, subtree: true, characterData: true });
            mirrorPagefindMessage();
        }

        setTimeout(()=>{
            const searchInput = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
            if (searchInput) {
                searchInput.id = 'search-input';
                searchInput.focus();
            }
            document.getElementById("pagefind_container")?.removeAttribute("data-astro-transition-scope");
        }, 50);
    });
</script>
